# Sanity Configuration
# Get these values from https://www.sanity.io/manage
SANITY_PROJECT_ID=sanity-project-id
SANITY_DATASET=sanity-dataset-name #production or other dataset
SANITY_API_VERSION=sanity-api-version #2021-03-25
SANITY_API_TOKEN=your-sanity-api-token # it is a must if dataset is private

# Revalidation Configuration
# Generate a secure random token for webhook authentication
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET_TOKEN=your-secret-token-here
